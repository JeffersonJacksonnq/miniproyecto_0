# 6. BUCLE PRINCIPAL DEL JUEGO
# ==========================================
try:
    while True:
        color_rgb(0, 0, 0)
        GPIO.output(PIN_LED1, GPIO.LOW)
       
        habitats_validos = obtener_clima_y_habitats()
        if not habitats_validos:
            time.sleep(2)
            continue
           
        opciones_principales = habitats_validos + ["Ver Mi Equipo", "Actualizar Clima", "Salir"]
        eleccion_habitat = navegar_menu(opciones_principales, "ZONA SAFARI - MENÚ PRINCIPAL")

        if eleccion_habitat == "Salir":
            print("\n¡Gracias por visitar la Zona Safari Pokémon!")
            break
        elif eleccion_habitat == "Actualizar Clima":
            continue
        elif eleccion_habitat == "Ver Mi Equipo":
            if not equipo_jugador:
                print("\nTu equipo está vacío. ¡Ve a explorar para atrapar a tu primer Pokémon!")
                time.sleep(2)
                continue
           
            nombres_equipo = [f"{p['nombre']} [{p['datos']['tipo']}]" for p in equipo_jugador]
            eleccion_str = navegar_menu(nombres_equipo + ["Volver"], "MI EQUIPO POKÉMON")
           
            if eleccion_str != "Volver":
                nombre_real = eleccion_str.split(" [")[0]
                mi_pkmn = next(p for p in equipo_jugador if p["nombre"] == nombre_real)
                datos = mi_pkmn["datos"]
                print("\n" + "*"*35)
                print(f"       COMPAÑERO: {nombre_real.upper()}")
                print("*"*35)
                print(f" Tipo: {datos['tipo']} | HP Máximo: {datos['hp_max']}")
                print(f" Ataque 1: {datos['ataques'][0]['nombre']} [{datos['ataques'][0]['tipo']}] (Daño: {datos['ataques'][0]['daño']})")
                print(f" Ataque 2: {datos['ataques'][1]['nombre']} [{datos['ataques'][1]['tipo']}] (Daño: {datos['ataques'][1]['daño']})")
                print("*"*35)
                print("\nPresiona el botón del joystick para regresar...")
                while leer_joystick() != "SELECT": time.sleep(0.05)
                tono_confirmacion()
            continue

        while True:
            actualizar_led_habitat(eleccion_habitat)
            accion_habitat = navegar_menu(["Próxima aventura", "Ver Pokédex", "Volver"], f"EXPLORANDO {eleccion_habitat.upper()}")

            if accion_habitat == "Volver":
                GPIO.output(PIN_LED1, GPIO.LOW)
                break
               
            elif accion_habitat == "Ver Pokédex":
                pokemon_disponibles = [f"{n} [{d['tipo']}]" for n, d in zona_safari[eleccion_habitat].items() if d["cantidad"] > 0]
                if not pokemon_disponibles:
                    print("\n¡No quedan Pokémon en esta zona!")
                    time.sleep(1.5)
                    continue
                eleccion_str = navegar_menu(pokemon_disponibles + ["Volver"], "SELECCIONA UN POKÉMON")
                if eleccion_str != "Volver":
                    nombre_real = eleccion_str.split(" [")[0]
                    datos = zona_safari[eleccion_habitat][nombre_real]
                    print("\n" + "*"*35)
                    print(f"       POKÉDEX: {nombre_real.upper()}")
                    print("*"*35)
                    print(f" Tipo: {datos['tipo']} | HP Max: {datos['hp_max']}")
                    print(f" Prob. Captura: {datos['prob_captura']}% | Población: {datos['cantidad']}")
                    print(f" Ataques: {datos['ataques'][0]['nombre']} [{datos['ataques'][0]['tipo']}], {datos['ataques'][1]['nombre']} [{datos['ataques'][1]['tipo']}]")
                    print("*"*35)
                    print("\nPresiona el botón para regresar...")
                    while leer_joystick() != "SELECT": time.sleep(0.05)
                    tono_confirmacion()

            elif accion_habitat == "Próxima aventura":
                pokemon_disponibles = [n for n, d in zona_safari[eleccion_habitat].items() if d["cantidad"] > 0]
               
                opciones_evento = ["Descansar", "Atrapar"]
                if len(equipo_jugador) > 0 and len(pokemon_disponibles) > 0:
                    opciones_evento.append("Combatir")
               
                if not pokemon_disponibles: evento_sorteado = "Descansar"
                else: evento_sorteado = random.choice(opciones_evento)

                if evento_sorteado == "Descansar":
                    print(f"\n💤 DESCANSANDO EN {eleccion_habitat.upper()} 💤")
                    print("Te tomas un momento de paz en la naturaleza.")
                    while leer_joystick() != "SELECT": time.sleep(0.05)
                    tono_confirmacion()

                elif evento_sorteado == "Atrapar":
                    pkmn_salvaje = random.choice(pokemon_disponibles)
                    datos_pkmn = zona_safari[eleccion_habitat][pkmn_salvaje]
                    probabilidad = datos_pkmn["prob_captura"]
                   
                    print(f"\n¡UN {pkmn_salvaje.upper()} [{datos_pkmn['tipo'].upper()}] SALVAJE APARECIÓ!")
                    tono_aparicion()
                    color_rgb(0, 0, 1)
                   
                    while True:
                        accion = navegar_menu(["Lanzar Poké Ball", "Dar Comida", "Escapar"], f"ENCUENTRO: {pkmn_salvaje.upper()} (Prob: {probabilidad}%)")
                        if accion == "Escapar":
                            color_rgb(0, 1, 0)
                            tono_escape()
                            time.sleep(1)
                            color_rgb(0, 0, 0)
                            break
                        elif accion == "Dar Comida":
                            probabilidad = min(100, probabilidad + 15)
                            sonar_buzzer(1200, 0.1)
                        elif accion == "Lanzar Poké Ball":
                            time.sleep(1)
                            if random.randint(1, 100) <= probabilidad:
                                print(f"¡Atrapaste a {pkmn_salvaje}!")
                                color_rgb(1, 0, 0)
                                tono_captura_exitosa()
                                datos_pkmn["cantidad"] -= 1
                               
                                if len(equipo_jugador) < 6:
                                    equipo_jugador.append({"nombre": pkmn_salvaje, "datos": dict(datos_pkmn)})
                                else:
                                    gestionar_captura_llena(pkmn_salvaje, datos_pkmn)
                                time.sleep(2)
                            else:
                                print(f"¡{pkmn_salvaje} escapó!")
                                color_rgb(0, 1, 0)
                                tono_escape()
                                time.sleep(2)
                            color_rgb(0, 0, 0)
                            break

                elif evento_sorteado == "Combatir":
                    pkmn_salvaje = random.choice(pokemon_disponibles)
                    datos_pkmn = zona_safari[eleccion_habitat][pkmn_salvaje]
                    iniciar_combate(pkmn_salvaje, datos_pkmn)

finally:
    buzzer_pwm.stop()
    color_rgb(0, 0, 0)
    GPIO.output(PIN_LED1, GPIO.LOW)
    GPIO.cleanup()
    sensor.exit()
