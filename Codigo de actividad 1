# 4. HARDWARE Y SENSORES
# ==========================================
def leer_eje_y_i2c():
    if not i2c_disponible: return 13000
    try:
        bus.write_i2c_block_data(I2C_ADDRESS, 0x01, [0xD3, 0x83])
        time.sleep(0.01)
        data = bus.read_i2c_block_data(I2C_ADDRESS, 0x00, 2)
        return (data[0] << 8) | data[1]
    except Exception: return 13000

def leer_joystick():
    if GPIO.input(PIN_SW) == GPIO.LOW:
        time.sleep(0.2)
        return "SELECT"
    valor_y = leer_eje_y_i2c()
    if valor_y < 5000:
        time.sleep(0.2)
        return "ARRIBA"
    elif valor_y > 21000:
        time.sleep(0.2)
        return "ABAJO"
    return None

def obtener_clima_y_habitats():
    habitats = []
    try:
        temperatura = sensor.temperature
        humedad = sensor.humidity
        print(f"\n[SENSOR DHT11] Temp: {temperatura}°C | Humedad: {humedad}%")
        if temperatura is not None and humedad is not None:
            if temperatura < 21.0: habitats.append("Cueva")
            else: habitats.append("Pradera")
            if humedad >= 55.0: habitats.append("Pantano")
            else: habitats.append("Bosque")
        else: print("El sensor arrojó valores vacíos.")
    except RuntimeError as error:
        print(f"Error de lectura: {error.args[0]}")
        habitats = ["Pradera", "Bosque"]
    return habitats

def navegar_menu(opciones, titulo="SELECCIONE UNA OPCIÓN"):
    indice = 0
    total = len(opciones)
    while True:
        print("\n" + "="*35)
        print(f" {titulo}")
        print("="*35)
        for i, opcion in enumerate(opciones):
            indicador = "-> " if i == indice else "   "
            print(f"{indicador}{opcion}")
        while True:
            accion = leer_joystick()
            if accion == "ARRIBA":
                indice = (indice - 1) % total
                tono_desplazamiento()
                break
            elif accion == "ABAJO":
                indice = (indice + 1) % total
                tono_desplazamiento()
                break
            elif accion == "SELECT":
                tono_confirmacion()
                return opciones[indice]
            time.sleep(0.05)

