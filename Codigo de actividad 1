def calcular_efectividad(tipo_ataque, tipo_defensa):
    efectividad = {
        "Planta": {"Agua": 2.0, "Roca": 2.0, "Veneno": 0.5, "Bicho": 0.5},
        "Agua": {"Roca": 2.0, "Planta": 0.5},
        "Roca": {"Bicho": 2.0, "Eléctrico": 2.0, "Agua": 0.5, "Planta": 0.5},
        "Bicho": {"Planta": 2.0, "Roca": 0.5},
        "Eléctrico": {"Agua": 2.0, "Roca": 0.5, "Planta": 0.5},
        "Veneno": {"Planta": 2.0, "Roca": 0.5},
        "Normal": {"Roca": 0.5}
    }
    if tipo_ataque in efectividad and tipo_defensa in efectividad[tipo_ataque]:
        return efectividad[tipo_ataque][tipo_defensa]
    return 1.0

def gestionar_captura_llena(nuevo_pkmn, datos_nuevo):
    nombres_equipo = [f"{p['nombre']} [{p['datos']['tipo']}]" for p in equipo_jugador]
    print("\n¡Tu equipo está lleno! Debes liberar a un Pokémon.")
    eleccion_str = navegar_menu(nombres_equipo + ["Cancelar captura"], "¿A QUIÉN LIBERARÁS?")
   
    if eleccion_str != "Cancelar captura":
        nombre_real = eleccion_str.split(" [")[0]
        for i, p in enumerate(equipo_jugador):
            if p["nombre"] == nombre_real:
                del equipo_jugador[i]
                break
        equipo_jugador.append({"nombre": nuevo_pkmn, "datos": dict(datos_nuevo)})
        print(f"Has liberado a {nombre_real}. ¡Bienvenido {nuevo_pkmn}!")
        tono_captura_exitosa()
    else:
        print(f"Dejaste ir a {nuevo_pkmn}.")

def iniciar_combate(pkmn_salvaje, datos_salvaje):
    nombres_equipo = [f"{p['nombre']} [{p['datos']['tipo']}]" for p in equipo_jugador]
    pkmn_elegido_str = navegar_menu(nombres_equipo, "ELIGE TU POKÉMON PARA LUCHAR")
    nombre_mio = pkmn_elegido_str.split(" [")[0]
   
    mi_pkmn = next(p for p in equipo_jugador if p["nombre"] == nombre_mio)
    hp_mio = mi_pkmn["datos"]["hp_max"]
    hp_rival = datos_salvaje["hp_max"]
   
    print("\n" + "!"*35)
    print(f"  ¡BATALLA! {mi_pkmn['nombre'].upper()} VS {pkmn_salvaje.upper()}")
    print("!"*35)
    tono_aparicion()
    color_rgb(1, 0, 1)
    time.sleep(1)

    while hp_mio > 0 and hp_rival > 0:
        # Turno del Jugador
        nombres_ataques = [f"{atk['nombre']} [{atk['tipo']}]" for atk in mi_pkmn["datos"]["ataques"]]
        atk_elegido_str = navegar_menu(nombres_ataques, f"TU HP: {hp_mio} | RIVAL HP: {hp_rival}")
        nombre_atk = atk_elegido_str.split(" [")[0]
       
        datos_atk = next(a for a in mi_pkmn["datos"]["ataques"] if a["nombre"] == nombre_atk)
        mult = calcular_efectividad(datos_atk["tipo"], datos_salvaje["tipo"])
        daño_final = int(datos_atk["daño"] * mult)
        hp_rival -= daño_final
       
        print(f"\n¡{mi_pkmn['nombre']} usó {nombre_atk}!")
        if mult > 1.0:
            print("¡Es muy efectivo!")
            tono_dano_critico()
            color_rgb(0, 0, 1)
        elif mult < 1.0:
            print("No es muy efectivo...")
            tono_ataque()
           
        time.sleep(1)
        color_rgb(1, 0, 1)
        if hp_rival <= 0: break

        # Turno del Rival
        atk_rival = random.choice(datos_salvaje["ataques"])
        mult_rival = calcular_efectividad(atk_rival["tipo"], mi_pkmn["datos"]["tipo"])
        daño_rival = int(atk_rival["daño"] * mult_rival)
        hp_mio -= daño_rival

        print(f"\n¡El {pkmn_salvaje} enemigo usó {atk_rival['nombre']}!")
        if mult_rival > 1.0: print("¡Fue muy efectivo contra ti!")
        tono_ataque()
        color_rgb(1, 0, 0)
        time.sleep(0.5)
        color_rgb(1, 0, 1)
        time.sleep(1)

    # Resultados
    if hp_mio <= 0:
        print(f"\n¡Oh no! ¡Tu {mi_pkmn['nombre']} se ha debilitado!")
        print("Regla Nuzlocke: Tu Pokémon ha muerto y abandona tu equipo.")
        equipo_jugador.remove(mi_pkmn)
        color_rgb(0, 1, 0)
        tono_debilitado()
        time.sleep(3)
        color_rgb(0, 0, 0)
    elif hp_rival <= 0:
        print(f"\n¡Has derrotado al {pkmn_salvaje} salvaje!")
        datos_salvaje["cantidad"] -= 1
        color_rgb(1, 0, 0)
        tono_captura_exitosa()
        time.sleep(1)
       
        if navegar_menu(["Sí", "No"], f"¿Quieres atrapar a {pkmn_salvaje} derrotado?") == "Sí":
            if len(equipo_jugador) < 6:
                equipo_jugador.append({"nombre": pkmn_salvaje, "datos": dict(datos_salvaje)})
                print(f"¡{pkmn_salvaje} fue añadido a tu equipo!")
                tono_captura_exitosa()
            else:
                gestionar_captura_llena(pkmn_salvaje, datos_salvaje)
        color_rgb(0, 0, 0)

