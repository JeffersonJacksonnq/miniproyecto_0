# 3. FUNCIONES DE RETROALIMENTACIÓN
# ==========================================
def color_rgb(r, g, b):
    GPIO.output(PIN_R, r)
    GPIO.output(PIN_G, g)
    GPIO.output(PIN_B, b)

def actualizar_led_habitat(habitat):
    poblacion_total = sum(p["cantidad"] for p in zona_safari[habitat].values())
    if poblacion_total > 0: GPIO.output(PIN_LED1, GPIO.HIGH)
    else: GPIO.output(PIN_LED1, GPIO.LOW)

def sonar_buzzer(frecuencia, duracion):
    try:
        buzzer_pwm.ChangeFrequency(frecuencia)
        buzzer_pwm.start(50)
        time.sleep(duracion)
        buzzer_pwm.stop()
    except Exception:
        pass

def tono_desplazamiento(): sonar_buzzer(800, 0.05)
def tono_confirmacion():
    sonar_buzzer(1400, 0.08)
    time.sleep(0.02)
    sonar_buzzer(1800, 0.12)
def tono_aparicion():
    sonar_buzzer(600, 0.1)
    time.sleep(0.05)
    sonar_buzzer(900, 0.2)
def tono_captura_exitosa():
    sonar_buzzer(1046, 0.1)
    time.sleep(0.05)
    sonar_buzzer(1318, 0.1)
    time.sleep(0.05)
    sonar_buzzer(1567, 0.3)
def tono_escape():
    sonar_buzzer(400, 0.2)
    time.sleep(0.1)
    sonar_buzzer(300, 0.4)
def tono_ataque(): sonar_buzzer(1200, 0.1)
def tono_dano_critico():
    sonar_buzzer(2000, 0.1)
    time.sleep(0.05)
    sonar_buzzer(2000, 0.1)
def tono_debilitado():
    sonar_buzzer(300, 0.3)
    time.sleep(0.1)
    sonar_buzzer(250, 0.5)

